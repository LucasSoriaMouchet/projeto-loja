<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brechó Virtual da Dona Maria - Camisetas</title>
    <link rel="stylesheet" href="/styles/style.css">
    <link rel="stylesheet" href="/styles/infoprod.css">
    <link rel="shortcut icon" href="/images/icon.png" type="image/x-icon">
</head>
<body>
    <nav>
        <h1><span id="menu"></span> Brechó Virtual Dona Maria</h1>
        <menu>
        </menu>
    </nav>
    <main>
        <img src="/images/<%= camiseta.imagem %>" alt="Camiseta <%= camiseta.marca %>">
        <section id="info-produto">
        <h1>Camiseta <%= camiseta.marca %></h1>
            <p>
                R$ <%= camiseta.preco.toFixed(2) %>
                <br>
                ou em 10x de R$ <%= (camiseta.preco / 10).toFixed(2) %>
            </p>
            <form action="/carrinho" method="post">
                <div id="tamanhos">
                    <input type="hidden" name="id" value="<%= camiseta.id %>">
                    <input type="hidden" name="marca" value="<%= camiseta.marca %>">
                    <input type="hidden" name="preco" value="<%= camiseta.preco %>">
                    <input type="hidden" name="imagem" value="<%= camiseta.imagem %>">
                    <input type="hidden" name="tamanho" value="<%= camiseta.tamanho %>">

                    <input type="radio" name="tamanho" id="tamanho-p" value="P" checked>
                    <label for="tamanho-p">P</label>
                    <input type="radio" name="tamanho" id="tamanho-m" value="M">
                    <label for="tamanho-m">M</label>
                    <input type="radio" name="tamanho" id="tamanho-g" value="G">
                    <label for="tamanho-g">G</label>
                    <input type="radio" name="tamanho" id="tamanho-gg" value="GG">
                    <label for="tamanho-gg">GG</label>
                </div>
                <button type="submit">Adicionar ao Carrinho</button>
            </form>
        </main>
    </section>
</body>
</html>